# Multi-stage build for efficient Go application
# Use AMD64 builder to cross-compile ARM64 binary (Docker Hub has no QEMU support)
FROM golang:1.25-alpine AS builder

# Install build dependencies
RUN apk add --no-cache git ca-certificates tzdata

# Set working directory
WORKDIR /build

# Copy go mod files
COPY go.mod go.sum ./

# Download dependencies
RUN go mod download

# Copy source code
COPY *.go ./

# Cross-compile the application for ARM64
RUN CGO_ENABLED=0 GOOS=linux GOARCH=arm64 go build \
    -ldflags="-w -s" \
    -o traefik-acme-converter \
    .

# Final stage - minimal runtime image
# Use ARM64-specific Alpine digest but don't run ANY commands (avoids exec format error)
FROM alpine@sha256:24bb3511a0db7b5114a4aee033c65a8a4148f39b7b80a398e548546db967a36f

# Copy ca-certificates and tzdata from AMD64 builder stage
# This avoids running apk commands which require /bin/sh
COPY --from=builder /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/
COPY --from=builder /usr/share/zoneinfo /usr/share/zoneinfo

# Copy minimal necessary files for user/group from builder
# We'll run as root by default since we can't create users without running commands
# Users can override with --user flag in docker run

# Set working directory
WORKDIR /app

# Copy binary from builder
COPY --from=builder /build/traefik-acme-converter /app/traefik-acme-converter

# Add OCI labels for supply chain attestation
LABEL org.opencontainers.image.source="https://github.com/ShobuPrime/traefik-acme-converter" \
      org.opencontainers.image.description="Traefik ACME certificate converter with fsnotify (ARM64)" \
      org.opencontainers.image.licenses="GPL-3.0" \
      org.opencontainers.image.title="traefik-acme-converter" \
      org.opencontainers.image.vendor="ShobuPrime"

# Set default environment variables
ENV WATCH_DIR=/traefik/certs \
    PROVIDER=ACME \
    OUTPUT_DIR=/app/output \
    USER_UID=1000 \
    USER_GID=1000 \
    USE_WATCHER=true

# Run as root by default (can't create non-root user without running shell commands)
# Users can override with --user flag in docker-compose
# USER directive commented out to avoid exec format errors
# USER root

# Run the Go binary directly (no shell wrapper needed)
ENTRYPOINT ["/app/traefik-acme-converter"]
